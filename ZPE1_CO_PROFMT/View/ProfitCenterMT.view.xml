<mvc:View controllerName="zpe1coprofmt.zpe1coprofmt.controller.ProfitCenterMT"
    xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizData="sap.viz.ui5.data"
    xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">
    <Page id="page" showHeader="false" class="pePage" busy="{view>/busy}">
        <content>
            <VBox class="peShell">

                <!-- ===== Hero (글로시, sticky) ===== -->
                <VBox class="peHeroSticky">
                <HBox class="peHero" alignItems="Center" justifyContent="SpaceBetween">
                    <HBox alignItems="Center" class="peHeroLeft">
                        <core:Icon src="sap-icon://building" class="peHeroIcon"/>
                        <VBox class="peHeroTitleBox">
                            <Text text="손익센터 관리" class="peHeroTitle"/>
                            <Text text="손익센터 마스터 테이블 활성화 여부 설정" class="peHeroSub"/>
                        </VBox>
                    </HBox>
                    <HBox class="peHeroMetrics" alignItems="Center">
                        <VBox class="peHeroMetric">
                            <Text text="전체 손익센터" class="peHeroMetricLabel"/>
                            <Text text="{= ${view>/results}.length } 건" class="peHeroMetricValue"/>
                        </VBox>
                    </HBox>
                </HBox>
                <!-- ===== 얇은 툴바 (EVAL 필터바 위치 흉내) — 새로고침 ===== -->
                <VBox class="peFilterBar">
                    <HBox class="peFilterRowTop" alignItems="Center" justifyContent="End">
                        <HBox class="peFilterActions" alignItems="Center">
                            <Button text="새로고침" icon="sap-icon://refresh" type="Transparent" press=".onRefresh" class="peBtnRefresh"/>
                        </HBox>
                    </HBox>
                </VBox>
                </VBox>

                <!-- ===== 콘텐츠: 좌 2/3 테이블 + 우 1/3 차트(도넛+컬럼) ===== -->
                <HBox class="peContentRow peHeroAligned" alignItems="Start">

                    <!-- 좌: 목록 (2/3) -->
                    <VBox class="peSection peTableSection peCol2">
                        <layoutData><FlexItemData growFactor="2" baseSize="0%"/></layoutData>
                        <HBox class="peSectionHead" alignItems="Center" justifyContent="SpaceBetween">
                            <HBox alignItems="Center">
                                <Title text="손익센터 목록" class="peSectionTitle"/>
                                <Text text="{= ${view>/results}.length } 건" class="peCountChip"/>
                            </HBox>
                            <SearchField width="18rem" placeholder="손익센터 코드/명칭 검색"
                                search=".onSearch" liveChange=".onSearch"/>
                        </HBox>
                        <Table id="pcTable" items="{view>/results}" growing="true" growingThreshold="100"
                            noDataText="표시할 손익센터가 없습니다.">
                            <columns>
                                <Column><Text text="손익센터"/></Column>
                                <Column><Text text="명칭"/></Column>
                                <Column hAlign="Center"><Text text="플랜트"/></Column>
                                <Column hAlign="Center"><Text text="유형"/></Column>
                                <Column><Text text="유효기간"/></Column>
                                <Column hAlign="Center"><Text text="상태"/></Column>
                                <Column hAlign="End"><Text text="작업"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{view>Prctr}" class="peMemberName"/>
                                        <Text text="{view>Ptext}"/>
                                        <Text text="{view>Werks}"/>
                                        <Text text="{view>Pctype}"/>
                                        <Text text="{ parts: [ {path:'view>Datab'}, {path:'view>Datbi'} ], formatter: '.fmtPeriod' }"/>
                                        <ObjectStatus
                                            text="{path:'view>Loekz', formatter:'.fmtLoekzText'}"
                                            state="{path:'view>Loekz', formatter:'.fmtLoekzState'}"/>
                                        <Button type="Transparent"
                                            text="{path:'view>Loekz', formatter:'.fmtBtnText'}"
                                            icon="{path:'view>Loekz', formatter:'.fmtBtnIcon'}"
                                            press=".onToggleLoekz"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                    <!-- 우: 차트 컬럼 (1/3) -->
                    <VBox class="peCol1 peChartCol">
                        <layoutData><FlexItemData growFactor="1" baseSize="0%"/></layoutData>

                        <!-- 도넛: 구분 비율 -->
                        <VBox class="peChartPanel peAccentGreen">
                            <Title text="손익센터 구분 비율" class="peChartTitle"/>
                            <Text text="접두(PCA/PCC/PCL/PCP)별 손익센터 수" class="peChartSub"/>
                            <viz:VizFrame id="pcDonut" vizType="donut" height="260px" width="100%"
                                uiConfig="{applicationSet:'fiori'}">
                                <viz:dataset>
                                    <vizData:FlattenedDataset data="{view>/chart}">
                                        <vizData:dimensions>
                                            <vizData:DimensionDefinition name="구분" value="{view>name}"/>
                                        </vizData:dimensions>
                                        <vizData:measures>
                                            <vizData:MeasureDefinition name="건수" value="{view>value}"/>
                                        </vizData:measures>
                                    </vizData:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <vizFeeds:FeedItem uid="size" type="Measure" values="건수"/>
                                    <vizFeeds:FeedItem uid="color" type="Dimension" values="구분"/>
                                </viz:feeds>
                            </viz:VizFrame>
                        </VBox>

                        <!-- 컬럼: 유효시작 연도별 분포 -->
                        <VBox class="peChartPanel peAccentBlue">
                            <Title text="유효시작 연도별 분포" class="peChartTitle"/>
                            <Text text="유효시작 연도별 손익센터 수" class="peChartSub"/>
                            <viz:VizFrame id="pcYearCol" vizType="column" class="peYearViz" height="320px" width="100%"
                                uiConfig="{applicationSet:'fiori'}">
                                <viz:dataset>
                                    <vizData:FlattenedDataset data="{view>/chartYear}">
                                        <vizData:dimensions>
                                            <vizData:DimensionDefinition name="시작연도" value="{view>year}"/>
                                        </vizData:dimensions>
                                        <vizData:measures>
                                            <vizData:MeasureDefinition name="건수" value="{view>value}"/>
                                        </vizData:measures>
                                    </vizData:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <vizFeeds:FeedItem uid="valueAxis" type="Measure" values="건수"/>
                                    <vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="시작연도"/>
                                </viz:feeds>
                            </viz:VizFrame>
                        </VBox>

                    </VBox>

                </HBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
